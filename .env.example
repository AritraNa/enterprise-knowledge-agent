# Values used by Docker Compose. Copy this file to .env and replace passwords.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-to-a-strong-password

# Ollama models. Pull them with the "setup" Compose profile after starting Ollama.
EMBEDDING_MODEL=nomic-embed-text
DOCUMENT_INGESTION_MODEL=llama3.2
OLLAMA_API_KEY=ollama

# Optional application settings
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=5
RAG_MIN_SIMILARITY_SCORE=0.4
RAG_MIN_EMPLOYEE_SIMILARITY_SCORE=0.4
MAX_UPLOAD_BYTES=52428800
# HR_API_KEY=
