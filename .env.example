# Configuration used by the API container. Copy this file to .env and replace
# the connection details with endpoints reachable from the container.
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-to-a-strong-password

# For Ollama running on the Docker host, use host.docker.internal as shown.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text
DOCUMENT_INGESTION_MODEL=llama3.2
OLLAMA_API_KEY=ollama

# Optional application settings.
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=5
RAG_MIN_SIMILARITY_SCORE=0.4
RAG_MIN_EMPLOYEE_SIMILARITY_SCORE=0.4
MAX_UPLOAD_BYTES=52428800
# HR_API_KEY=
